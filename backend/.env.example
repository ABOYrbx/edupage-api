# Datenbank (Default: SQLite-Datei data/edupage-api.db)
DATABASE_URL=sqlite+aiosqlite:///./data/edupage-api.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/edupage_api

# Vault-Schluessel (32 Byte, hex). Wird beim ersten Start automatisch generiert, falls leer.
# WICHTIG: Nach dem ersten Start hier eintragen, sonst sind gespeicherte Passwoerter
# nach einem Neustart nicht mehr entschluesselbar.
CREDENTIAL_ENCRYPTION_KEY=
# Alternative: Schluessel aus einer Datei lesen (hat Vorrang vor automatischer Erzeugung,
# aber CREDENTIAL_ENCRYPTION_KEY gewinnt, wenn gesetzt). Im Docker-Image vorbelegt mit
# /app/data/credential.key, damit Journal und `docker compose exec` denselben Key sehen.
# CREDENTIAL_ENCRYPTION_KEY_FILE=

# Admin-Zugang (wird beim ersten Start angelegt, falls DB leer)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-on-first-run

# Server
HOST=0.0.0.0
PORT=8787
# CORS (kommasepariert; leer = same-origin)
CORS_ORIGINS=
# Auf true setzen, sobald der Dienst hinter HTTPS laeuft (Secure-Cookies).
COOKIE_SECURE=false

# Wetter-Endpunkte (/wetter, /wetter/suche). Leer = Endpunkte antworten mit 503.
OPENWEATHER_API_KEY=

# Rate-Limits
ADMIN_LOGIN_LIMIT=20/10minute
AGENT_LIMIT=120/minute

# Cache-TTLs (Sekunden)
CACHE_TTL_MESSAGES=900
CACHE_TTL_GRADES=3600
CACHE_TTL_TIMETABLE=3600
CACHE_TTL_WEATHER=300
SESSION_CACHE_TTL=300
