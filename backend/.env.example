# Datenbank (Default: SQLite-Datei data/edupage-api.db)
DATABASE_URL=sqlite+aiosqlite:///./data/edupage-api.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/edupage_api

# Vault-Schluessel (32 Byte, hex). Wird beim ersten Start automatisch generiert, falls leer.
CREDENTIAL_ENCRYPTION_KEY=

# Admin-Zugang (wird beim ersten Start angelegt, falls DB leer)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-on-first-run

# Server
HOST=0.0.0.0
PORT=8787
# CORS (kommasepariert; leer = same-origin)
CORS_ORIGINS=

# Rate-Limits
ADMIN_LOGIN_LIMIT=20/10minute
AGENT_LIMIT=120/minute

# Cache-TTLs (Sekunden)
CACHE_TTL_MESSAGES=900
CACHE_TTL_GRADES=3600
CACHE_TTL_TIMETABLE=3600
CACHE_TTL_WEATHER=300
SESSION_CACHE_TTL=300
