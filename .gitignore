# ---------------------------------------------------------------------------
# Geheimnisse. Nichts davon darf je ins Repository.
# ---------------------------------------------------------------------------

# .env-Dateien in jedem Verzeichnis, Vorlagen bleiben erlaubt.
.env
.env.*
!.env.example

# Schlüssel und Zertifikate
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
*.secret
*.token
*.pass
id_rsa*
id_ed25519*
id_ecdsa*

# Weitere Zugangsdaten
.npmrc
.netrc
.pgpass
.htpasswd
credentials.json
credentials*.json
client_secret*.json
service-account*.json
secrets/
secrets.*

# Lokale Anwendungsdaten: Datenbank, Vault-Key, Downloads.
# Ohne data/credential.key sind gespeicherte EduPage-Passwörter verloren —
# deshalb gehört dieses Verzeichnis ins Backup, aber niemals ins Repo.
data/
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.dump
*.sql.gz
backups/

# ---------------------------------------------------------------------------
