# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/
pip-wheel-metadata/

# ---------------------------------------------------------------------------
